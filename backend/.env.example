PORT=
NODE_ENV=
MONGO_URI=
FRONTEND_URL=
JWT_SECRET=

# ── Agent brain (backend/src/agent) ───────────────────────────────────────
# LLM provider: auto (default) = gemini → openai → deterministic offline mock
LLM_PROVIDER=auto
GEMINI_API_KEY=
# Verified 2026-10-20:
#   gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3-pro-preview
#     -> RETIRED (404 "no longer available")
#   gemini-3-flash-preview  -> works, but free tier is capped at 20 requests/DAY.
#                              A full agent run needs ~15-20 calls, so one run can
#                              exhaust the whole daily allowance.
#   gemini-3.1-flash-lite   -> confirmed working with JSON mode, separate quota.
#                              This is the recommended default.
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search. Optional: without a key the agent falls back to DuckDuckGo
# (keyless) and Wikipedia (keyless corroboration source).
TAVILY_API_KEY=

# Set to false to create sessions without starting the agent automatically.
AGENT_ENABLED=true

# Rate limiting (free-tier friendly)
#
# NOTE on the Gemini free tier: it allows only ~5 requests/minute. A full agent
# run makes roughly 15-20 LLM calls (plan, per-source extraction, reflect,
# synthesise, audit), so the default 400ms gap WILL hit HTTP 429 partway
# through and the remaining calls degrade to the deterministic mock. That is
# graceful degradation, not a crash — but for a fully Gemini-authored report
# raise this to ~13000, or point at a paid key.
AGENT_LLM_MIN_INTERVAL_MS=400
# DuckDuckGo's HTML endpoint throttles aggressively — keep this >= 1000ms or
# you will get empty pages back during a demo.
AGENT_DDG_MIN_INTERVAL_MS=1500
AGENT_WIKIPEDIA_MIN_INTERVAL_MS=700
AGENT_SEARCH_RETRY_BACKOFF_MS=2500

# Loop bounds — these are the anti-infinite-loop guarantees.
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TASKS=8
AGENT_MAX_LLM_CALLS=40
AGENT_MAX_QUERIES_PER_TASK=2
AGENT_MAX_SOURCES_PER_QUERY=4
AGENT_MIN_EVIDENCE_PER_TASK=2
AGENT_DEFAULT_MAX_SOURCES=12
