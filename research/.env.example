# ── Research module environment variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore, so it will NEVER be committed to Git.

# Tavily Search API key — free tier at https://app.tavily.com
# Sign up, copy the key that starts with "tvly-", and paste it below.
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# Set to "true" to run in mock/demo mode without consuming API credits.
# Useful for testing when you do not have a key yet.
RESEARCH_MOCK_MODE=false
